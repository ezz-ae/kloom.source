# /etc/systemd/system/ora-mcp.service
# sudo systemctl enable --now ora-mcp
[Unit]
Description=Ora MCP server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ora/mcp-server
ExecStart=/usr/bin/node dist/index.js
Environment=NODE_ENV=production
Environment=MCP_PORT=3001
Restart=always
RestartSec=3
User=ora

[Install]
WantedBy=multi-user.target
