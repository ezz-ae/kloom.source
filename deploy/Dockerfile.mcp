# ── Ora MCP server ─────────────────────────────────────────────────────────
# Build context = repo root:  docker build -f deploy/Dockerfile.mcp -t ora-mcp .
FROM node:22-slim AS build
RUN corepack enable
WORKDIR /app/mcp-server
COPY mcp-server/package.json ./
RUN pnpm install
COPY mcp-server/ ./
RUN pnpm build

FROM node:22-slim AS runner
WORKDIR /app/mcp-server
ENV NODE_ENV=production MCP_PORT=3001
COPY --from=build /app/mcp-server/package.json ./
COPY --from=build /app/mcp-server/node_modules ./node_modules
COPY --from=build /app/mcp-server/dist ./dist
EXPOSE 3001
CMD ["node", "dist/index.js"]
