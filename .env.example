# KLOOM - Multi-AI Conversation Platform
# Environment Variables

# ============================================================================
# SOLANA CONFIGURATION
# ============================================================================

# Solana RPC URL (Mainnet)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solana Network (mainnet-beta, devnet, testnet)
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# ============================================================================
# AI BACKEND API KEYS
# ============================================================================

# Mistral AI (Recommended for multilingual and cost-effective)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI GPT
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================================
# LOCAL LLM CONFIGURATION (Ollama)
# ============================================================================

# Ollama / OpenAI-compatible endpoint
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local
LLM_MODEL=llama3.2:latest

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (Client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================================
# JWT SECRET (For session management)
# ============================================================================

# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# ============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================================================

# PayPal (Global)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox  # or "live" for production

# Ziina (UAE-specific)
ZIINA_API_KEY=your_ziina_api_key_here
ZIINA_SECRET_KEY=your_ziina_secret_key_here
ZIINA_ENVIRONMENT=sandbox  # or "production"

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Application Name
NEXT_PUBLIC_APP_NAME=KLOOM

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Debug Mode
NEXT_PUBLIC_DEBUG=false

# Enable Analytics (Optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ============================================================================
# VOICE CHAT CONFIGURATION
# ============================================================================

# Fish Audio TTS API (for voice synthesis)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# STT (Speech-to-Text) Provider
# Options: "fish", "whisper", "assemblyai"
STT_PROVIDER=fish

# AssemblyAI (Alternative STT)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ============================================================================
# MCP SERVER CONFIGURATION
# ============================================================================

# MCP Server Port
MCP_SERVER_PORT=3001

# Enable MCP Server
ENABLE_MCP_SERVER=true

# ============================================================================
# RATE LIMITING
# ============================================================================

# Requests per minute per IP
RATE_LIMIT_REQUESTS=60

# Requests per minute per user
RATE_LIMIT_USER_REQUESTS=120

# ============================================================================
# CREDIT SYSTEM
# ============================================================================

# Free voice minutes for new users
FREE_VOICE_MINUTES=5

# Voice cost per minute (in USD)
VOICE_COST_PER_MINUTE=1

# Unlimited voice subscription price (in USD)
UNLIMITED_VOICE_PRICE=60

# Unrestricted mode price (in USD)
UNRESTRICTED_MODE_PRICE=10

# ============================================================================
# SECURITY
# ============================================================================

# CORS Origins (comma-separated)
NEXT_PUBLIC_CORS_ORIGINS=http://localhost:3000,https://your-production-url.com

# CSRF Protection
CSRF_SECRET=your_csrf_secret_here

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

# SMTP Host
SMTP_HOST=

# SMTP Port
SMTP_PORT=587

# SMTP Username
SMTP_USER=

# SMTP Password
SMTP_PASSWORD=

# Sender Email
EMAIL_FROM=noreply@kloom.ai

# ============================================================================
# LOGGING
# ============================================================================

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Enable Sentry
ENABLE_SENTRY=false

# Sentry DSN
SENTRY_DSN=

# ============================================================================
# NOTES
# ============================================================================

# 1. Copy this file to .env.local for development
# 2. Never commit .env.local to version control
# 3. For production, set these variables in your hosting provider
# 4. All NEXT_PUBLIC_* variables are exposed to the client
# 5. Non-NEXT_PUBLIC_* variables are server-side only

# ============================================================================
# QUICK START
# ============================================================================

# For local development, you only need:
# - SOLANA_RPC_URL (or use default)
# - At least one AI backend API key (MISTRAL_API_KEY recommended)
# - SUPABASE_URL and SUPABASE_ANON_KEY

# Example minimal .env.local:
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# MISTRAL_API_KEY=sk_your_key_here
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
