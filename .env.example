# ============================================================================
# kloom.source Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values
# Do NOT commit your .env file to version control

# ============================================================================
# NEXT.JS CONFIGURATION
# ============================================================================

# Application URL (used for callbacks, emails, etc.)
NEXT_PUBLIC_URL=http://localhost:3000

# Environment (development, staging, production)
NEXT_PUBLIC_ENV=development

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

# Public Supabase URL
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Public Supabase anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (for server-side operations - keep this SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================================
# AI PROVIDER API KEYS
# ============================================================================
# Get these from your respective provider dashboards

# Mistral AI - https://console.mistral.ai/
# RECOMMENDED: Mistral is cost-effective and excellent for most use cases
MISTRAL_API_KEY=your-mistral-api-key

# Anthropic Claude - https://console.anthropic.com/
# Best for complex reasoning and coding
CLAUDE_API_KEY=your-claude-api-key

# Google Gemini - https://aistudio.google.com/
# Best for creative tasks and multimodal
GEMINI_API_KEY=your-gemini-api-key

# OpenAI - https://platform.openai.com/
# Industry standard
OPENAI_API_KEY=your-openai-api-key

# ============================================================================
# BLOCKCHAIN CONFIGURATION (Solana)
# ============================================================================
# Optional: For blockchain payments and NFT features

# Solana RPC URL
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Private key for transactions (keep this SECRET)
# Generate with: solana-keygen new --outfile solana-key.json
SOLANA_PRIVATE_KEY=your-private-key-base58

# ============================================================================
# PAYMENT PROVIDERS
# ============================================================================
# Optional: For processing payments

# PayPal - https://developer.paypal.com/
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_ENV=sandbox # or production

# Ziina (Middle East payments) - https://ziina.com/
ZIINA_API_KEY=your-ziina-api-key
ZIINA_ENV=sandbox # or production

# ============================================================================
# MCP SERVER CONFIGURATION
# ============================================================================
# Model Context Protocol server for AI tools

# MCP Server URL (default: http://localhost:3001)
MCP_SERVER_URL=http://localhost:3001

# MCP Server API Key (optional, for authentication)
MCP_API_KEY=your-mcp-api-key

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Default AI model for new users
# Options: local, claude, gemini, openai, mistral
NEXT_PUBLIC_DEFAULT_MODEL=mistral

# Enable analytics (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Max tokens per message
NEXT_PUBLIC_MAX_TOKENS=4096

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60 # seconds

# ============================================================================
# DATABASE CONFIGURATION (Optional)
# ============================================================================
# If not using Supabase for database

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/kloom

# Redis URL (for caching)
REDIS_URL=redis://localhost:6379

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
# For sending transactional emails

# SMTP host
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# Email from address
EMAIL_FROM=noreply@kloom.source

# ============================================================================
# FILE STORAGE (Optional)
# ============================================================================

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Or use local storage
FILE_STORAGE_PATH=./uploads

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret

# Session secret
SESSION_SECRET=your-session-secret

# Encryption key (32 bytes base64)
ENCRYPTION_KEY=your-encryption-key

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable experimental features
NEXT_PUBLIC_ENABLE_EXPERIMENTAL=false

# Enable beta features
NEXT_PUBLIC_ENABLE_BETA=false

# Enable debug mode
NEXT_PUBLIC_ENABLE_DEBUG=false

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Sentry DSN (for error tracking)
SENTRY_DSN=your-sentry-dsn

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================================================
# NOTES
# ============================================================================
# 1. Mistral API key is RECOMMENDED for most use cases
# 2. All API keys should be kept SECRET
# 3. For production, use HTTPS and secure cookies
# 4. Rotate secrets regularly
# 5. Never commit .env to version control