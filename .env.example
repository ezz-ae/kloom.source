# ── Kloom.ai environment ───────────────────────────────────────────────
# Copy to .env.local for local dev. On Vercel, set these in
# Project → Settings → Environment Variables (NOT in this file).
# Never commit .env.local.

# ── LLM backend (OpenAI-compatible /chat/completions) ──────────────────
# The web app on Vercel calls this endpoint over HTTPS. It must be a
# PUBLICLY reachable URL — Vercel serverless functions cannot reach
# localhost or a private VPS network.
#
# CLOUD (recommended): self-host an open-weights model on a GPU box for the
# no-restriction product — e.g. Qwen via Ollama or vLLM on Alibaba Cloud ECS
# GPU. Open weights = uncensored. Expose it behind HTTPS + an API key.
#   LLM_BASE_URL=https://llm.yourdomain.com/v1
#   LLM_API_KEY=<the bearer token your gateway requires>
#   LLM_MODEL=qwen2.5:14b-instruct        # whatever you pulled in Ollama
#
# NOTE: Alibaba's *hosted* DashScope API (dashscope-intl.aliyuncs.com) is
# OpenAI-compatible and works here too, BUT it is content-moderated — it will
# refuse the explicit "unrestricted" companion personas. Use self-hosted open
# weights for the no-restriction tier.
#
# LOCAL DEV default (Ollama on your machine):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local
LLM_MODEL=hf.co/bartowski/L3-8B-Stheno-v3.2-GGUF:Q4_K_M
# Optional per-tier model overrides (fall back to LLM_MODEL if unset):
# LLM_MODEL_UNCENSORED=     # free companion/roleplay
# LLM_MODEL_UNRESTRICTED=   # $95 full-access tier
# LLM_FALLBACK_MODEL=

# ── Intent-routed UNCENSORED endpoint (the no-restriction half) ─────────
# Adult/dark/explicit/unrestricted turns route HERE; everything else uses the
# endpoint above. Point this at a self-hosted open-weights model (Qwen/etc. via
# Ollama or vLLM on a GPU, or a serverless GPU that scales to zero). The cheap
# cloud above handles general traffic, so this only runs for adult content.
# If unset, those turns fall back to the default LLM_BASE_URL.
# Safety note: the intent gate (lib/intent.ts) blocks CSAM + operational-harm
# BEFORE any call, so this endpoint only ever receives lawful content.
# UNCENSORED_LLM_BASE_URL=https://gpu.yourdomain.com/v1
# UNCENSORED_LLM_API_KEY=
# UNCENSORED_LLM_MODEL=qwen2.5:14b-instruct   # or an uncensored/abliterated open model

# Optional cloud model seats (used only by personas that request them):
# ANTHROPIC_API_KEY=        CLAUDE_MODEL=claude-sonnet-4-5
# GEMINI_API_KEY=           GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=  OPENAI_BASE_URL=  OPENAI_MODEL=gpt-4o

# xAI / Grok — the PRIMARY voice model on airraw when set (OpenAI-compatible,
# permissive for the adult floor). Get a key at https://console.x.ai
# XAI_API_KEY=
# XAI_MODEL=grok-4-fast-non-reasoning     # or grok-4.3, grok-3, etc.
# XAI_BASE_URL=https://api.x.ai/v1

# ── MCP server (kloom-mcp-server / github.com/ezz-ae/mcp-kloom) ─────────
# Serves persona forcing-prompts + tools (crypto, search, compute, creator).
# OPTIONAL — chat degrades gracefully if unreachable (generic prompt, no tools).
# Run it on the cloud (same GPU box or a small node) and expose /mcp over HTTPS.
# Must be publicly reachable from Vercel.
# Leave UNSET in production — the app serves its own /api/mcp on the same deployment
# and derives the URL from the request origin. Only set this for an EXTERNAL MCP
# server. (A localhost value is ignored on Vercel so a copied default can't break tools.)
# MCP_SERVER_URL=http://localhost:3001/mcp

# Fish Audio — text-to-speech (https://fish.audio)
FISH_API_KEY=
FISH_MODEL=s1
FISH_VOICE_ID=
FISH_LATENCY=balanced
# Optional per-voice overrides: FISH_VOICE_ALLOY=, FISH_VOICE_SAGE=, etc.

# ── Speech-to-text (Whisper) — used by voice chat (/api/stt) ────────────
# Each spoken utterance is recorded in the browser and POSTed here for an
# accurate transcript. Replaces the browser's webkitSpeechRecognition (which
# mangles names like "Claude"). OpenAI-compatible /audio/transcriptions, so it
# works against the hosted Whisper API now and a self-hosted GPU Whisper server
# (faster-whisper / whisper.cpp) later — just point STT_BASE_URL at it.
# If STT_API_KEY is unset it falls back to OPENAI_API_KEY.
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Solana / $KLOOM token (client-readable, inlined at build time)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_KLOOM_MINT=

# Card payments (Ziina) — server-side
ZIINA_API_KEY=
# Public site URL — set to your Vercel production domain (used for redirects/callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Browser speech-to-text fallback (Web Speech API, no key). Set to 1 to skip
# server Whisper entirely — useful when no STT key is available. Chrome/Edge/
# Safari only, requires https or localhost. Default (unset) = server STT with
# automatic browser fallback on auth/model failure.
NEXT_PUBLIC_STT_BROWSER=0

# ── AIRRAW deploy (the airraw.com ad-launch build) ─────────────────────
# Set ALL of these on the airraw Vercel project. See LAUNCH.md for the full
# pre-flight. Without them the landing mis-brands, mis-tracks, or over-spends.
#
# Serve the AIRRAW landing at / and brand robots/sitemap as airraw:
AIRRAW_HOME=1
# Public production URL (drives canonicals, OG, robots/sitemap host):
#   NEXT_PUBLIC_APP_URL=https://airraw.com
#
# Spend protection (REQUIRED before paid traffic — see LAUNCH.md):
#   AIRRAW_DAILY_CALL_CAP = max billable AI calls/instance/day. Unset => 5000.
#   Size it from budget: ~$0.005–0.02/call, e.g. $50/day ≈ 2,500–10,000.
AIRRAW_DAILY_CALL_CAP=5000
#   AIRRAW_KILL=1 = emergency stop (rejects all /api/chat + /api/tts). Unset = run.
# AIRRAW_KILL=
# Also set a HARD provider-side spend cap (Fish/RunPod) + Vercel spend mgmt —
# the in-memory cap above is per-instance, so providers are the real backstop.
#
# Ad pixels (client-inlined; events no-op until set). Set whichever you run:
# NEXT_PUBLIC_FB_PIXEL_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# NEXT_PUBLIC_GA_ID=
#
# Supabase (lead capture) — same project as the rest of the app:
# NEXT_PUBLIC_SUPABASE_URL=   NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Run db/airraw_leads.sql once against that project (table + writer fn + policy).
